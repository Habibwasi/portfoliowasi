{
  "name": "portfolio-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:readme": "remotion render src/index.ts Readme out/readme.mp4",
    "render:linkedin": "remotion render src/index.ts LinkedIn out/linkedin.mp4",
    "smoke": "tsx scripts/render-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:retrieval": "tsx scripts/export-retrieval.ts",
    "export:numbers": "tsx scripts/export-numbers.ts",
    "export:tests": "tsx scripts/export-tests.ts",
    "capture": "tsx capture/run.ts",
    "export:site": "tsx scripts/export-site.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
