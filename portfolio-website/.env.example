# Copy to .env.local and fill in. Never commit real values.

# Contact form (/api/contact). Exists today.
RESEND_API_KEY=

# AI guide (/api/guide), from Phase 3. Server only.
GROQ_API_KEY=
# Separate key for the guide evaluation, so evals don't use the production quota.
GROQ_EVAL_API_KEY=

# Rate limiting for the contact form (Phase 1) and the guide (Phase 3).
# Created through the Upstash integration in the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public values.
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_SITE_URL=https://portfolio-habib-wasi.vercel.app
